<?xml version="1.0"?>
<?xml-model
  href="http://download.ros.org/schema/package_format3.xsd"
  schematypens="http://www.w3.org/2001/XMLSchema"?>

<package format="3">

  <name>pid_tuning</name>
  <version>0.1.0</version>

  <description>
    Adaptación a ROS 2 Jazzy del paquete We-R22/pid_tuning para el
    ajuste de controladores PID mediante Evolución Diferencial.
  </description>

  <maintainer email="mitchellgomez@upp.edu.mx">
    Mitchell Angel Gomez Ortega
  </maintainer>

  <author>We-R22</author>

  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <depend>std_msgs</depend>
  <depend>rclpy</depend>
  <depend>ros_gz_interfaces</depend>
  <depend>ament_index_python</depend>
  <depend>control_msgs</depend>
  <depend>trajectory_msgs</depend>
  <depend>tf2_ros</depend>

  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-pandas</exec_depend>

  <exec_depend>rosidl_default_runtime</exec_depend>

  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>

</package>
